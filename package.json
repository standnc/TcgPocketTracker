{
  "name": "ptcgp-mcp-server",
  "version": "1.1.0",
  "description": "Provider-agnostic MCP server for a local Pokémon TCG Pocket catalog and collection",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "ptcgp-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "smoke:http": "npm run build && node dist/scripts/smoke-http.js",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run format && npm run lint && npm run test && npm run smoke && npm run smoke:http && npm run pack:check",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "sync": "node dist/scripts/sync-catalog.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "inspect:http": "npx @modelcontextprotocol/inspector http://127.0.0.1:8787/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
