# Optional. Keep this directory outside the repository when using a public clone.
# PTCGP_DATA_DIR=/absolute/path/to/ptcgp-mcp-data

# --- Transporte HTTP (opcional, solo si arrancas `npm run start:http`) ---
# Ninguno de estos valores es necesario para el modo stdio por defecto.

# Interfaz y puerto en los que escucha el server HTTP. Mantén loopback si vas
# detrás de un proxy (Caddy/Nginx); publica solo el proxy.
# PTCGP_HTTP_HOST=127.0.0.1
# PTCGP_HTTP_PORT=8787

# Token estático de acceso: >= 32 caracteres. Genera con `openssl rand -hex 32`.
# NO comitees el valor real. En despliegue va en /etc/ptcgp-mcp-server/http.env
# (modo 0600), no aquí.
# PTCGP_HTTP_TOKEN=

# CSV de hosts aceptados (defensa contra DNS rebinding). Default:
# localhost,127.0.0.1. Añade tu dominio público si expones el server.
# PTCGP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# CSV de orígenes CORS aceptados. Déjalo vacío para clientes server-to-server
# (Inspector CLI, ChatGPT connector) que no envían cabecera Origin.
# PTCGP_HTTP_ALLOWED_ORIGINS=

# Límite del cuerpo por petición (KiB) y timeout de lectura (ms).
# PTCGP_HTTP_BODY_LIMIT_KIB=1024
# PTCGP_HTTP_REQUEST_TIMEOUT_MS=30000

# Rate limit en memoria por IP (por defecto: 60 peticiones/minuto/IP).
# PTCGP_HTTP_RATE_LIMIT_MAX=60
# PTCGP_HTTP_RATE_LIMIT_WINDOW_MS=60000
# PTCGP_HTTP_RATE_LIMIT_MAX_KEYS=10000
