# EnvironmentFile de systemd para ptcgp-mcp-http.service. Copia a
# /etc/ptcgp-mcp-server/http.env con permisos 0600 y sustituye los valores.
# Nunca versiones el archivo real con secretos.

# Directorio persistente de datos SQLite (WAL). Debe existir, ser propiedad del
# usuario de servicio y estar en disco local (no NFS/SMB).
PTCGP_DATA_DIR=/var/lib/ptcgp-mcp

# Nivel de log estructurado (pino). fatal|error|warn|info|debug|trace|silent.
PTCGP_LOG_LEVEL=info

# Interfaz y puerto en los que escucha el server. En despliegues detrás de
# proxy (Caddy/Nginx), mantén loopback y publica solo el proxy.
PTCGP_HTTP_HOST=127.0.0.1
PTCGP_HTTP_PORT=8787

# Token estático de acceso. Genera al menos 32 bytes de entropía y no lo
# reutilices entre entornos. Ejemplo: openssl rand -hex 32
PTCGP_HTTP_TOKEN=

# Lista CSV de hosts aceptados en la cabecera Host (protección DNS rebinding).
# Añade tu dominio público y mantén localhost/127.0.0.1 para pruebas locales.
PTCGP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1

# Lista CSV de orígenes CORS aceptados. Déjala vacía si solo esperas clientes
# server-to-server o Inspector CLI (que no envían cabecera Origin).
PTCGP_HTTP_ALLOWED_ORIGINS=

# Límite del cuerpo aceptado en cada petición (KiB). El default cubre cualquier
# JSON-RPC razonable; súbelo solo si tienes evidencia.
PTCGP_HTTP_BODY_LIMIT_KIB=1024

# Timeout en milisegundos para completar la lectura del cuerpo.
PTCGP_HTTP_REQUEST_TIMEOUT_MS=30000

# Rate limit en memoria por IP reenviada por el proxy. La ventana fija por
# defecto admite 60 peticiones por IP y minuto; max_keys evita crecimiento
# sin límite si se reciben muchas IPs distintas.
PTCGP_HTTP_RATE_LIMIT_MAX=60
PTCGP_HTTP_RATE_LIMIT_WINDOW_MS=60000
PTCGP_HTTP_RATE_LIMIT_MAX_KEYS=10000
